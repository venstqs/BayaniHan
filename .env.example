# Copy this file to .env and fill in your Supabase project values
# (Supabase Dashboard → Project Settings → API). Leave empty to run in offline demo mode.
# The anon key is meant to be public; Row Level Security in supabase/schema.sql protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
